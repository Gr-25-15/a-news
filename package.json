{
  "name": "a-news",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db": "(docker ps --filter 'name=a-news-app-db' --format '{{.Names}}' | grep -q a-news-app-db && docker start a-news-app-db) || (docker ps -a --filter 'name=a-news-app-db' --format '{{.Names}}' | grep -q a-news-app-db && docker start a-news-app-db) || docker run --name a-news-app-db -p 5432:5432 -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=a-news_db -d postgres",
    "dockdev": "npm run db && next dev",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "seed": "tsx -r dotenv/config scripts/seed.ts",
    "stripe": "dotenv -- node scripts/stripe.js",
    "stripe:login": "dotenv -- node scripts/stripe.js login"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.20",
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.982.0",
    "@base-ui/react": "^1.1.0",
    "@better-auth/stripe": "^1.4.16",
    "@daveyplate/better-auth-ui": "^3.3.15",
    "@lexical/html": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/selection": "^0.39.0",
    "@lexical/utils": "^0.39.0",
    "@lexkit/editor": "^0.0.38",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "ai": "^6.0.67",
    "better-auth": "^1.4.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "finnhub": "^2.0.12",
    "input-otp": "^1.4.2",
    "lexical": "^0.39.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.17.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.5.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.7.0",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "prisma": "^7.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
